* ECE 5362
* Machine Problem 3
* Nathan Fullerton

***********************************
* Important layout considerations *
* SRC: T2=addr, T3=value          *
* DST: T4=addr, T5=value          *
* nst=50 -- sets SRC and DST      *
* nst=55 -- sets DST              *
***********************************

** Start fetch cycle **
 st=0 rt='[pc]-> mar'		imar rac=1 rn=3
 st=1 rt='[[mar]]-> mdr'	read
 st=2 rt='[mdr] -> ir'		omdr iir
 st=3 rt='[pc]+1 -> q'		rac=1 rn=3 ib p1 oadder
 st=4 rt='[q] -> pc'		oq wac=1 wn=3

* Jumps for special instructions
	cond='ir158' value=0 nst=59

* Jump for single-operand instructions
	cond='ir1512' value=0 nst=30

* Continue for double-operand instructions
** Get source and store addr in T2 and val in T3 **
*	check source address type
	cond='ir118' value=5 nst=12
	cond='ir118' value=6 nst=12
 st=5 rt='[Rsrc] -> T1, T3'		rac=2 it1 it3
	cond='ir118' value=3 nst=6
	cond='ir118' value=0 nst=30
	nst=8
*	potential autodecrement
 st=6 rt='[T1] - 1 -> q'		oa oadder comp
 st=7 rt='[q] -> Rsrc'			oq wac=2
	nst=9
* skip autodec
 st=8 rt='[T1] -> q'			oa oadder
 st=9 rt='[q] -> T2'			oq it2
	cond='ir118' value=2 nst=10
* jump for index
	cond='ir118' value=4 nst=12
	nst=20
*	potential autoinc
 st=10 rt='[T1] + 1 -> q'		oa oadder p1
 st=11 rt='[q] -> Rsrc'			oq wac=2
* ^it's safe to write because we already have initial value
	nst=20
* immediate/absolute/index check
 st=12 rt='[pc]-> mar'			imar rac=1 rn=3
 st=13 rt='[[mar]]-> mdr'		read
* if immediate, put val in T3, if absolute, put T2 and continue to memory grab
 st=14 rt='[mdr] -> T3, T1'		omdr it3 it1
	cond='ir118' value=4 nst=16
 st=15 rt='[mdr] -> T2'			omdr it2
 st=16 rt='[pc]+1 -> q'			rac=1 rn=3 ib p1 oadder
 st=17 rt='[q] -> pc'			oq wac=1 wn=3
	cond='ir118' value=6 nst=30
	cond='ir118' value=5 nst=20

* index
 st=18 rt='[T1] + [T2] -> q'	oa ot2 ib oadder
 st=19 rt='[q] -> T2'			oq it2

* get from memory
 st=20 rt='[T2] -> mar'		ot2 imar
 st=21 rt='[[mar]] -> mdr'	read
 st=22 rt='[mdr] -> T3'		omdr it3
	nst=30

*******************************************
*        We now have our SRC var          *
* T2 = addr, T3 = val, Rn updated already *
*******************************************

** get dest and store addr in T4 and val in T5
* dst_calc
 st=30 rt='[Rdest] -> T4, T5'		rac=3 it4 it5
*	note: no immediate in dest, so only need include absolute. yay
*	also in case of absolute, above line is irreleven but catches src up
	cond='ir64' value=5 nst=34
	cond='ir64' value=0 nst=46
* potential autodecrement
	cond='ir64' value=3 nst=31
	cond='ir64' value=4 nst=34
	nst=42
 st=31 rt='[T4] -> T1'				ot4 it1
 st=32 rt='[T1] - 1 -> q'			oa comp oadder
 st=33 rt='[q] -> Rdest, T4'		oq wac=3 it4
*post autodec
	nst=42
*get absolute/index
 st=34 rt='[pc]-> mar'				imar rac=1 rn=3
 st=35 rt='[[mar]]-> mdr'			read
 st=36 rt='[mdr] -> T1'				omdr it1
 st=37 rt='[pc]+1 -> q'				rac=1 rn=3 ib p1 oadder
 st=38 rt='[q] -> pc'				oq wac=1 wn=3
 	cond='ir64' value=4 nst=40
 st=39 rt='[mdr] -> T4'				omdr it4
	nst=42

* index
 st=40 rt='[T1] + [T4] -> q'		oa ib ot4 oadder
 st=41 rt='[q] -> T4'				oq it4

* put dest into mar and t1 for autoinc
 st=42 rt='[T4] -> mar, T1'	ot4 it1 imar
 st=43 rt='[[mar]]->mdr, [T1] + 1 -> q'		read oa oadder p1 
 st=44 rt='[mdr] -> T5'		omdr it5
	cond='ir64' value=2 nst=45
	cond='ir1512' value=0 nst=47
	nst=46
* autoinc (the increment was done sneakily in state 42 and 43)
 st=45 rt='[q] -> Rdest'	oq wac=3
	cond='ir1512' value=0 nst=47

*******************************************
*        We now have our DEST var         *
* T4 = addr, T5 = val, Rn updated already *
*******************************************

*end of dest, NOP to gather different paths so all next step conditions are centralized
 st=46 rt='NOP'				ot2

* Place IR conditional jumps for double operand
*	Add
	cond='ir1512' value=1 nst=77
*	Sub
	cond='ir1512' value=2 nst=80
*	Exg
	cond='ir1512' value=4 nst=70

 st=47 rt='NOP'				ot2
* Place IR conditional jumps for single operand
*	Neg
	cond='ir118' value=4 nst=75
*	INC
	cond='ir118' value=2 nst=83

*******************************************
*          Write T3 back to SRC           *
*******************************************

* note: because of the ability to use absolute addressing,
* We must assume T2 can contain an address
* To begin, move T2 to MAR. If register mode, this is harmless
* If this gets run when there was an immediate value, that is the fault of the implementer
*	(also that is an unsupported operation so the programmer messed up)

 st=50 rt='[T2] -> MAR'				ot2 imar
	cond='ir118' value=0 nst=53
 st=51 rt='[T3] -> MDR'				ot3 imdr
 st=52 rt='[MDR] -> [MAR]'			write
*	written to memory, now just jump to dest
	nst=55
 st=53 rt='[T3] -> Rsrc'			ot3 wac=2
*	similar jump to dest
	nst=55

*******************************************
*          Write T5 back to DEST          *
*******************************************

 st=55 rt='[T4] -> MAR'				ot4 imar
	cond='ir64' value=0 nst=58
 st=56 rt='[T5] -> MDR'				ot5 imdr
 st=57 rt='[MDR] -> [MAR]'			write
* written to memory, now just jump to uh I guess start of program
	nst=0
 st=58 rt='[T5] -> Rdst'			ot5 wac=3
	nst=0

*********************************************
* Special Instruction Handling
* All IR sent here have 0000 0000 xxxx xxxx

 st=59 rt='nop'						ot2
	cond='ir76' value=0 nst=60
*	cond='ir76' value=8 nst=RST
 st=60 halt

***********************************************
* Main Instructions

*************************
*          EXG          *
*************************

 st=70 rt='[T3] -> q'		ot3 ib oadder
 st=71 rt='[T5] -> T3'		ot5 it3
 st=72 rt='[q] -> T5'		oq it5
	nst=50

*************************
*          NEG          *
*************************
 st=75 rt='0-[T5] -> q'					ot5 ib comp p1 oadder NEWC NEWV
 st=76 rt='[q] -> T5'					oq it5 NEWZ NEWN
	nst=55

*************************
*          ADD          *
*************************
 st=77 rt='[T3] -> T1'					ot3 it1
 st=78 rt='[T1] + [T5] -> q'			oa ib ot5 oadder NEWC NEWV
 st=79 rt='[q] -> T5'					oq it5 NEWZ NEWN
	nst=55

*************************
*          SUB          *
*************************
 st=80 rt='[T5] -> T1'					ot5 it1
 st=81 rt='[T1] - [T3] -> q'			oa ib ot3 comp p1 oadder NEWC NEWV
 st=82 rt='[q] -> T5'					oq it5 NEWZ NEWN
	nst=55

*************************
*          INC          *
*************************
 st=83 rt='[T5] + 1 -> q'				ot5 ib p1 oadder NEWC NEWV
 st=84 rt='[q] -> T5'					oq it5 NEWZ NEWN
	nst=55

*************************
*          JSR          *
*************************
 st=85 rt='[SP] -> T1'					rac=1 rn=2 it1
 st=86 rt='[T1]-1 -> q'					oa comp oadder
 st=87 rt='[q] -> SP, MAR'				oq wac=1 wn=2, imar
 st=88 rt='[PC] -> MDR'					rac=1 rn=3 imdr
 st=89 rt='[MDR] -> [MAR]'				write
 st=90 rt='[T5] -> PC'					ot5 wac=1 wn=3
 ** no need to write to dst, jump to next instruction directly
	nst=0
	

* end of file, put here to prevent issues with the program incorrectly skipping the last line