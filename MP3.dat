* ECE 5362
* Machine Problem 2
* Nathan Fullerton

** Start fetch cycle **
 st=0 rt='[pc]-> mar'		imar rac=1 rn=3
 st=1 rt='[[mar]]-> mdr'	read
 st=2 rt='[mdr] -> ir'		omdr iir
 st=3 rt='[pc]+1 -> q'		rac=1 rn=3 ib p1 oadder
 st=4 rt='[q] -> pc'		oq wac=1 wn=3

*	skip source calc if single operand operation
	cond='ir1512' value=0 nst=30
** Get source and store addr in T2 and val in T3 **
*	check source address type
	cond='ir118' value=5 nst=12
	cond='ir118' value=6 nst=12
 st=5 rt='[Rsrc] -> T1, T3'		rac=2 it1 it3
	cond='ir118' value=3 nst=6
	cond='ir118' value=0 nst=30
	nst=8
*	potential autodecrement
 st=6 rt='[T1] - 1 -> q'		oa oadder comp p1
 st=7 rt='[q] -> Rsrc'			oq wac=2
	nst=9
* skip autodec
 st=8 rt='[T1] -> q'			oa oadder
 st=9 rt='[q] -> T2'			oq it2
	cond='ir118' value=2 nst=10
* jump for index
	cond='ir118' value=4 nst=12
	nst=20
*	potential autoinc
 st=10 rt='[T1] + 1 -> q'		oa oadder p1
 st=11 rt='[q] -> Rsrc'			oq wac=2
* ^it's safe to write because we already have initial value
	nst=20
* immediate/absolute/index check
 st=12 rt='[pc]-> mar'			imar rac=1 rn=3
 st=13 rt='[[mar]]-> mdr'		read
* if immediate, put val in T3, if absolute, put T2 and continue to memory grab
 st=14 rt='[mdr] -> T3, T1'		omdr it3 it1
	cond='ir118' value=4 nst=16
 st=15 rt='[mdr] -> T2'			omdr it2
 st=16 rt='[pc]+1 -> q'			rac=1 rn=3 ib p1 oadder
 st=17 rt='[q] -> pc'			oq wac=1 wn=3
	cond='ir118' value=6 nst=30
	cond='ir118' value=5 nst=20

* index
 st=18 rt='[T1] + [T2] -> q'	oa ot2 ib oadder
 st=19 rt='[q] -> T2'			oq it2

* get from memory
 st=20 rt='[T2] -> mar'		ot2 imar
 st=21 rt='[[mar]] -> mdr'	read
 st=22 rt='[mdr] -> T3'		omdr it3
	nst=30

*******************************************
*        We now have our SRC var          *
* T2 = addr, T3 = val, Rn updated already *
*******************************************

** get dest and store addr in T4 and val in T5
* dst_calc
 st=30 rt='[Rdest] -> T4, T5'		rac=3 it4 it5
*	note: no immediate in dest, so only need include absolute. yay
*	also in case of absolute, above line is irreleven but catches src up
	cond='ir64' value=5 nst=34
	cond='ir64' value=0 nst=43
* potential autoincrement
	cond='ir64' value=3 nst=31
	nst=dest_mar
 st=31 rt='[T4] -> T1'			ot4 it1
 st=32 rt='[T1] - 1 -> q'		oa comp p1 oadder
 st=33 rt='[q] -> Rdest, T4'		oq wac=3 it4
*post autodec
	nst=dest_mar
*get absolute
 st=34 rt='[pc]-> mar'		imar rac=1 rn=3
 st=35 rt='[[mar]]-> mdr'	read
 st=36 rt='[mdr] -> T1'		omdr it1
	cond='ir64' value=4 nst=38
 st=37 rt='[mdr] -> T4'		omdr it4
 st=38 rt='[pc]+1 -> q'		rac=1 rn=3 ib p1 oadder
 st=39 rt='[q] -> pc'		oq wac=1 wn=3

* index

* put dest into mar and t1 for autoinc
 st=40 rt='[T4] -> mar, T1'	ot4 it1 imar
 st=41 rt='[[mar]]->mdr, [T4] + 1 -> q'		read oa oadder p1 
 st=42 rt='[mdr] -> T5'		omdr it5
	cond='ir64' value=2 nst=43
	nst=dest_end
* autoinc
 st=43 rt='[q] -> Rdest'	oq wac=3

*******************************************
*        We now have our DEST var         *
* T4 = addr, T5 = val, Rn updated already *
*******************************************

*end of dest, NOP to gather different paths so all next step conditions are centralized
 st=43 rt='NOP'				ot2